# WordPress (almacenamiento + imágenes)
# URL pública del WordPress que actúa como almacenamiento (imágenes + datos)
# Esta variable SÍ es pública (prefijo NEXT_PUBLIC_) y se expone al navegador
NEXT_PUBLIC_WORDPRESS_URL=https://wp.biyum.agency

# Token del plugin Biyum Storage (DEBE coincidir con el token configurado en WordPress > Ajustes > Biyum Storage)
# Esta variable es SECRETA - solo se usa en el servidor (API routes)
BIYUM_WP_TOKEN=

# Contraseña del panel de administración (/admin/login)
# Esta variable es SECRETA - solo se usa en el servidor (API route /api/auth/login)
ADMIN_PASSWORD=

# Telegram bot para avisos de leads del chat IA
# Estas variables son SECRETAS - solo se usan en el servidor (lib/ai/telegram.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Entorno de ejecución (Next.js lo usa internamente)
# En producción debe ser "production"
NODE_ENV=production